OPTIONMASTER_DHAN_CLIENT_ID=
OPTIONMASTER_DHAN_ACCESS_TOKEN=
OPTIONMASTER_EXECUTION_MODE=PAPER
OPTIONMASTER_HOST=127.0.0.1
OPTIONMASTER_PORT=8300
OPTIONMASTER_FRONTEND_PORT=5275
OPTIONMASTER_UNDERLYINGS=NIFTY,BANKNIFTY
OPTIONMASTER_JOURNAL_PATH=data/optionmaster.db
# Directory holding the strategy-lab option-chain snapshot CSVs used for backtests.
OPTIONMASTER_STORED_DATA_DIR=D:/alphaedge/strategy-lab/data/options
# Current exchange lot sizes used by the stored-data backtester.
OPTIONMASTER_BACKTEST_LOT_SIZES=NIFTY50:75,BANKNIFTY:35,SENSEX:20,FINNIFTY:65
# Telegram position alerts (open/close). Create a bot with @BotFather, get the
# chat id from @userinfobot, then verify with POST /api/v1/alerts/test.
OPTIONMASTER_TELEGRAM_BOT_TOKEN=
OPTIONMASTER_TELEGRAM_CHAT_ID=
